# Production-only env (used by `npm run build`). Dev/local is unaffected.
#
# Chrome Web Store listing for the ZooPrep Bluebook Importer (published, live).
# Public URL — not a secret — so it's committed and inlined at `npm run build`.
REACT_APP_EXTENSION_URL=https://chromewebstore.google.com/detail/zooprep-bluebook-importer/mljbkibogegecgmamgglnpbeachhadaf

# Error monitoring (optional). Set this in the Vercel build env to turn on
# Sentry; leave unset and error reporting is a no-op (the ErrorBoundary still
# catches crashes and shows a recoverable screen regardless).
# REACT_APP_SENTRY_DSN=

